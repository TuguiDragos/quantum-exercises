# --- quantum-exercises ---

# Local progress; .unreadable is a state file from another version, set aside.
.qx-state.json
.qx-state.json.unreadable
.qx-state-*.tmp

# Progress lock. Never deleted: that would race a process holding it.
.qx-state.lock

# Backups from `qx init --refresh`; in a clone the course is this repository.
*.bak
*.bak.[0-9]*

# Left only by a crash during an atomic lesson-file write.
.qx-refresh-*.tmp

.DS_Store

# Per-machine editor and assistant config.
.claude/
.cursor/
.aider*
.continue/

# IBM credentials belong in ~/.qiskit/, never in the repository.
qiskit-ibm.json
